+void CActor::UpdateVRPosture()
+{
+    const bool enabled=strstr(Core.Params,"-copvr")&&IsGameTypeSingle()&&!Remote()&&
+        copvr_game::standingMode()&&g_Alive()&&Level().CurrentViewEntity()==this&&!m_holder;
+    auto movement=character_physics_support()->movement();
+    if(!enabled) {
+        if(m_copvrStandingBoxValid) {
+            movement->SetBox(0,m_copvrStandingBox);
+            if(movement->BoxID()==0) movement->ActivateBox(0);
+            m_copvrStandingBoxValid=false;m_copvrEyeHeight=0;
+        }
+        if(copvr_game::hitPosture().owner==static_cast<IGameObject*>(this)) copvr_game::hitPosture()={};
+        return;
+    }
+    CopVrHead head{};
+    if(!copvr_game::postureHead(head)||Device.Paused()) return;
+    if(!m_copvrStandingBoxValid) {
+        m_copvrStandingBox=movement->Boxes()[0]; m_copvrStandingBoxValid=true;
+    }
+    const float nativeHeight=m_copvrStandingBox.vMax.y-m_copvrStandingBox.vMin.y;
+    CopVrHeight calibrated{};const bool known=copvr_game::standingHeight(calibrated);
+    m_copvrEyeHeight=known?_max(1.2f,_min(2.2f,calibrated.standingEyeHeight)):m_fCamHeightFactor*(nativeHeight-.05f);
+    const float fullHeight=m_copvrEyeHeight/m_fCamHeightFactor+.05f;
+    const float eye=m_copvrEyeHeight;
+    const float scale=copvr::postureScale(head.position[1],eye);
+    Fbox target=m_copvrStandingBox;
+    target.vMax.y=target.vMin.y+fullHeight*scale;
+    movement->ResizeStandingBoxVR(target);
+    copvr_game::hitPosture()={static_cast<IGameObject*>(this),scale*fullHeight/nativeHeight,Device.dwTimeGlobal};
+}
+// Optional engine query, scoped to the local live player and fresh tracking.
+extern "C" __declspec(dllexport) float copvr_actor_hit_scale(const void* owner)
+{
+    const auto& posture=copvr_game::hitPosture();
+    return posture.owner==owner&&Device.dwTimeGlobal-posture.timestamp<150?posture.scale:1.f;
+}
