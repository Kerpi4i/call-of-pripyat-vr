+
+shared_str CWeaponMagazined::VRMagazineProfile() const
+{
+    if(!strstr(Core.Params,"-copvr") || !smart_cast<const CActor*>(H_Parent())) return shared_str("");
+    string256 name; xr_strcpy(name,"magazine_vr_"); xr_strcat(name,HudSection().c_str());
+    auto ini=copvr_game::equipmentConfig();
+    return ini&&ini->section_exist(name)?shared_str(name):shared_str("");
+}
+bool CWeaponMagazined::VRPhysicalMagazine() const
+{
+    if(!VRMagazineProfile().size()) return false;
+    const auto gl=smart_cast<const CWeaponMagazinedWGrenade*>(this);
+    return !gl||!gl->m_bGrenadeMode;
+}
+bool CWeaponMagazined::VRRemoveMagazine()
+{
+    if(!VRPhysicalMagazine()||IsPending()||!m_vrMagazine.remove()) return false;
+    CWeapon::FireEnd(); m_bFireSingleShot=false;
+    StopCurrentAnimWithoutCallback();
+    // Native accounting preserves remaining rounds in the shared loose-ammo pool.
+    UnloadMagazine(true);
+    if(!VRPlayMechanical(0)) PlaySound("sndEmptyClick",get_LastFP());
+    SetPending(false); SwitchState(eIdle);
+    return true;
+}
+bool CWeaponMagazined::VRInsertMagazine()
+{
+    if(!VRPhysicalMagazine()||m_vrMagazine.present||IsPending()) return false;
+    CWeapon::FireEnd(); m_bFireSingleShot=false;
+    const bool jammed=IsMisfire();ReloadMagazine();bMisfire=jammed;
+    if(!m_vrMagazine.insert(iAmmoElapsed,VRRequiresManualRack())) return false;
+    if(!VRRequiresManualRack()) {
+        if(jammed)m_vrJamAnimation=2;
+        bMisfire=false;
+    }
+    if(!VRPlayMechanical(1)) PlaySound("sndEmptyClick",get_LastFP());StopCurrentAnimWithoutCallback();
+    SetPending(false); SwitchState(eIdle);
+    return true;
+}
+bool CWeaponMagazined::VRRack()
+{
+    if(!VRPhysicalMagazine()||!m_vrMagazine.rack(iAmmoElapsed,IsMisfire())) return false;
+    if(IsMisfire())m_vrJamAnimation=2;
+    bMisfire=false; CWeapon::FireEnd(); m_bFireSingleShot=false;
+    if(!VRPlayMechanical(2)) {
+        if(m_sounds.FindSoundItem("sndClose",false)) PlaySound("sndClose",get_LastFP());
+        else PlaySound("sndEmptyClick",get_LastFP());
+    }
+    StopCurrentAnimWithoutCallback(); SetPending(false); SwitchState(eIdle);
+    return true;
+}
+
+bool CWeaponMagazined::VRRequiresManualRack() const
+{
+    const auto profile=VRMagazineProfile();auto ini=copvr_game::equipmentConfig();
+    return !profile.size()||!ini||!ini->line_exist(profile,"manual_rack")||ini->r_bool(profile,"manual_rack");
+}
+bool CWeaponMagazined::VRPlayMechanical(u8 action)
+{
+    if(action>=3||!strstr(Core.Params,"-copvr")||!ParentIsActor())return false;
+    string256 section;xr_strcpy(section,"mechanical_audio_");xr_strcat(section,HudSection().c_str());
+    auto ini=copvr_game::equipmentConfig();const char* keys[]={"remove","insert","rack"};
+    string256 internal;xr_strcpy(internal,"internal_audio_");xr_strcat(internal,HudSection().c_str());
+    if(ini&&VRInternalKind()!=0&&ini->line_exist(internal,keys[action]))xr_strcpy(section,internal);
+    if(!ini||!ini->section_exist(section)||!ini->line_exist(section,keys[action]))return false;
+    const char* path=ini->r_string(section,keys[action]);
+    if(!m_vrMechanical[action]._get()||m_vrMechanicalSource[action]!=path) {
+        string_path file;xr_sprintf(file,"%s.ogg",path);
+        if(!FS.exist("$game_sounds$",file))return false;
+        m_vrMechanical[action].destroy();
+        if(!m_vrMechanical[action].create(path,st_Effect,m_eSoundReload))return false;
+        m_vrMechanicalSource[action]=path;
+    }
+    auto& sound=m_vrMechanical[action];sound.stop();
+    sound.play_at_pos(H_Root(),HudItemData()?HudItemData()->m_item_transform.c:Position(),0);
+    sound.set_volume(ini->line_exist(section,"volume")?ini->r_float(section,"volume"):1.f);
+    return true;
+}
+void CWeaponMagazined::VRManualReload()
+{
+    m_vrManualReloadSound=true;Reload();
+    if(GetNextState()!=eReload)m_vrManualReloadSound=false;
+}
+
+shared_str CWeaponMagazined::VRInternalProfile() const {
+    if(!strstr(Core.Params,"-copvr")||!smart_cast<const CActor*>(H_Parent()))return shared_str("");
+    string256 name;xr_strcpy(name,"internal_vr_");xr_strcat(name,HudSection().c_str());
+    auto ini=copvr_game::equipmentConfig();return ini&&ini->section_exist(name)?shared_str(name):shared_str("");
+}
+int CWeaponMagazined::VRInternalKind() const {
+    const auto profile=VRInternalProfile();return profile.size()?copvr_game::equipmentConfig()->r_s32(profile,"kind"):0;
+}
+void CWeaponMagazined::VRSyncInternal() {
+    const int kind=VRInternalKind();if(!kind)return;
+    if(!m_vrInternal.initialized) {
+        m_vrInternal.init(iAmmoElapsed,copvr::InternalKind(kind));
+        m_vrChamberAmmo[0]=m_magazine.empty()?m_ammoType:m_magazine.back().m_LocalAmmoType;
+        m_vrChamberAmmo[1]=m_magazine.size()<2?m_ammoType:m_magazine.front().m_LocalAmmoType;
+    }
+    if(kind==5&&m_vrRestoreChambers) {
+        unsigned count=0;for(unsigned bits=m_vrInternal.live;bits;bits>>=1)count+=bits&1u;
+        if(count!=unsigned(iAmmoElapsed))m_vrInternal.live=iAmmoElapsed>=6?63u:iAmmoElapsed>0?(1u<<iAmmoElapsed)-1u:0u;
+        const bool empty=m_vrInternal.needsPump;
+        if(empty?!!(m_vrInternal.live&(1u<<m_vrInternal.cursor)):!(m_vrInternal.live&(1u<<m_vrInternal.cursor)))m_vrInternal.drumNext(empty);
+    }
+    if(kind==2&&m_vrRestoreChambers) {
+        m_magazine.clear();
+        for(int i=1;i>=0;--i)if(m_vrInternal.live&(1u<<i)) {
+            const u8 type=m_vrChamberAmmo[i]<m_ammoTypes.size()?m_vrChamberAmmo[i]:m_ammoType;
+            CCartridge round;round.Load(m_ammoTypes[type].c_str(),type);m_magazine.push_back(round);
+        }
+        iAmmoElapsed=int(m_magazine.size());
+    }
+    m_vrRestoreChambers=false;
+}
+bool CWeaponMagazined::VRInternalCanFire() const {
+    const int kind=VRInternalKind();if(!kind)return true;
+    return m_vrInternal.canFire(copvr::InternalKind(kind))&&Device.dwTimeGlobal>=m_vrInternalCockingUntil;
+}
+bool CWeaponMagazined::VRLoadInternalRound(CWeaponAmmo* source,int chamber) {
+    const int kind=VRInternalKind();VRSyncInternal();
+    if(!kind||IsPending()||GetState()==eFire||GetNextState()==eFire||!source||!source->m_boxCurr||
+        source->H_Parent()!=H_Parent()||iAmmoElapsed>=iMagazineSize)return false;
+    if(kind==1) {
+        auto ini=copvr_game::equipmentConfig();const auto profile=VRInternalProfile();
+        const bool requireOpen=ini->line_exist(profile,"load_requires_open")&&ini->r_bool(profile,"load_requires_open");
+        if(!m_vrInternal.canLoadTube(requireOpen))return false;
+    }
+    if(kind==2&&!m_vrInternal.canLoad(chamber))return false;
+    if(kind==5&&!m_vrInternal.drumCanLoad())return false;
+    const u8 type=m_set_next_ammoType_on_reload<m_ammoTypes.size()?m_set_next_ammoType_on_reload:m_ammoType;
+    if(type>=m_ammoTypes.size()||xr_strcmp(source->cNameSect(),m_ammoTypes[type]))return false;
+    CCartridge round;round.Load(m_ammoTypes[type].c_str(),type);
+    if(!source->Get(round))return false;
+    round.m_LocalAmmoType=type;m_ammoType=type;m_set_next_ammoType_on_reload=undefined_ammo_type;
+    if(kind==2) {
+        m_vrInternal.load(chamber);m_vrChamberAmmo[chamber]=type;m_magazine.clear();
+        for(int i=1;i>=0;--i)if(m_vrInternal.live&(1u<<i)) {
+            CCartridge cartridge;const auto t=m_vrChamberAmmo[i]<m_ammoTypes.size()?m_vrChamberAmmo[i]:m_ammoType;
+            cartridge.Load(m_ammoTypes[t].c_str(),t);m_magazine.push_back(cartridge);
+        }
+        iAmmoElapsed=int(m_magazine.size());
+    } else {
+        const bool chambered=(kind==1||kind==4)&&iAmmoElapsed>0&&!m_vrInternal.needsPump;
+        if(kind==1||kind==4)m_vrInternal.tubeLoaded(iAmmoElapsed);
+        if(chambered)m_magazine.insert(m_magazine.end()-1,round);else m_magazine.push_back(round);
+        ++iAmmoElapsed;
+    }
+    if(!source->m_boxCurr&&OnServer())source->SetDropManual(true);
+    m_BriefInfo_CalcFrame=0;if(m_pInventory)m_pInventory->InvalidateState();
+    if(kind==5){m_vrInternal.drumLoad();if(auto rg=smart_cast<CWeaponRG6*>(this))rg->VRRoundLoaded();}
+    VRPlayMechanical(1);
+    Msg("* CoPVR internal load weapon=%u kind=%d chamber=%d ammo=%d",ID(),kind,chamber,iAmmoElapsed);
+    if(kind==3) {
+        if(auto rpg=smart_cast<CWeaponRPG7*>(this))rpg->VRRoundLoaded();
+        bMisfire=false;m_vrInternalFinish=true;SwitchState(eIdle);
+    }
+    return true;
+}
+void CWeaponMagazined::VRInternalAfterShot() {
+    const int kind=VRInternalKind();if(kind!=1&&kind!=2&&kind!=5)return;
+    if(!m_vrInternal.initialized)m_vrInternal.init(iAmmoElapsed+1,copvr::InternalKind(kind));
+    m_vrInternal.shot(copvr::InternalKind(kind));
+    bWorking=false;m_bFireSingleShot=false;
+}
+unsigned CWeaponMagazined::VRInternalEject() {
+    VRSyncInternal();const auto mask=m_vrInternal.eject();
+    if(mask)Msg("* CoPVR internal eject weapon=%u chambers=%u",ID(),mask);
+    return mask;
+}
+void CWeaponMagazined::VRInternalPump(float amount) {
+    if(VRInternalKind()!=1&&VRInternalKind()!=4)return;VRSyncInternal();
+    const bool wasRear=m_vrInternal.rearReached;
+    const bool completed=m_vrInternal.pumpTo(amount,iAmmoElapsed);
+    if(!wasRear&&m_vrInternal.rearReached) { VRPlayMechanical(0);Msg("* CoPVR pump rear weapon=%u",ID()); }
+    if(completed) { bMisfire=false;VRPlayMechanical(2);Msg("* CoPVR pump ready weapon=%u ammo=%d",ID(),iAmmoElapsed); }
+}
+void CWeaponMagazined::VRInternalBreak(float angle) {
+    if(VRInternalKind()!=2)return;VRSyncInternal();const float previous=m_vrInternal.angle;
+    m_vrInternal.angle=_max(0.f,_min(.65f,angle));
+    if(previous<.05f&&m_vrInternal.angle>=.05f) {
+        CWeapon::FireEnd();bWorking=false;m_bFireSingleShot=false;VRPlayMechanical(0);
+        Msg("* CoPVR break opening weapon=%u live=%u spent=%u",ID(),m_vrInternal.live,m_vrInternal.spent);
