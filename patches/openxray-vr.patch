+bool CUIActorMenu::VrUnloadDragged(int hand)
+{
+    if(!strstr(Core.Params,"-copvr")||!IsGameTypeSingle()||(m_currMenuMode!=mmInventory&&m_currMenuMode!=mmDeadBodySearch&&m_currMenuMode!=mmTrade)||
+        !IsShown()||!CUIDragDropListEx::m_drag_item) return false;
+    auto actor=smart_cast<CActor*>(m_pActorInvOwner);
+    auto cell=CUIDragDropListEx::m_drag_item->ParentItem();
+    auto item=cell?static_cast<PIItem>(cell->m_pData):nullptr;
+    auto weapon=item?smart_cast<CWeaponMagazined*>(item):nullptr;
+    if(!actor||!actor->g_Alive()||!weapon||!item->object().H_Parent()||
+        weapon->IsPending()||weapon->GetAmmoElapsed()<=0) return false;
+    const bool owned=item->object().H_Parent()==actor;
+    const bool loot=m_currMenuMode==mmDeadBodySearch&&cell->OwnerList()&&GetListType(cell->OwnerList())==iDeadBodyBag;
+    if(!owned&&!loot) return false;
+
+    // Operate on this exact dragged weapon, not its stacked children.
+    weapon->UnloadMagazine();
+    UpdateItemsPlace();
+    copvr_game::pulse(hand,.4f,45);
+    Msg("* CoPVR: dragged weapon unloaded hand=%d id=%u",hand,item->object().ID());
+    return true;
+}
+
+bool CUIActorMenu::VrExtractHovered(int hand)
+{
+    if(!strstr(Core.Params,"-copvr")||!IsGameTypeSingle()||m_currMenuMode!=mmInventory||
+        !IsShown()||CUIDragDropListEx::m_drag_item) return false;
+    auto actor=smart_cast<CActor*>(m_pActorInvOwner);
+    if(!actor||!actor->g_Alive()) return false;
+    const auto cursor=GetUICursor().GetCursorPosition();
+    for(auto list:m_pLists) {
+        if(!list||!list->IsShown()) continue;
+        const auto type=GetListType(list);
+        if(type!=iActorBag&&type!=iActorBelt&&type!=iActorSlot) continue;
+        Frect bounds; list->GetAbsoluteRect(bounds); if(!bounds.in(cursor.x,cursor.y)) continue;
+        for(u32 index=0;index<list->ItemsCount();++index) {
+            auto cell=list->GetItemIdx(index); if(!cell||!cell->IsShown()) continue;
+            cell->GetAbsoluteRect(bounds); if(!bounds.in(cursor.x,cursor.y)) continue;
+            auto item=static_cast<PIItem>(cell->m_pData);
+            if(!item||!copvr_game::queueInventoryExtraction(*actor,*item,hand)) return false;
+            if(hand==copvr_game::secondaryHand()&&g_player_hud->attached_item(1)) {
+                if(auto detector=smart_cast<CCustomDetector*>(actor->inventory().ItemFromSlot(DETECTOR_SLOT)))
+                    detector->HideDetector(true);
+            }
+            SendEvent_Item_Drop(item,actor->ID()); SetCurrentItem(nullptr);
+            copvr_game::pulse(hand,.2f,20);
+            Msg("* CoPVR: inventory extraction requested hand=%d id=%u",hand,item->object().ID());
+            return true;
+        }
+    }
+    return false;
+}
