+void CUIZoneMap::Draw()
+{
+    if(strstr(Core.Params,"-copvr")&&m_activeMap->IsRounded()) {
+        // Match exactly the native circular map's centre, radius and widescreen correction.
+        static ui_shader black; if(!black->inited()) black->create("hud\\default","copvr\\zone");
+        GEnv.UIRender->SetShader(*black);
+        GEnv.UIRender->CacheSetCullMode(IUIRender::cmNONE);
+        constexpr int segments=64;
+        GEnv.UIRender->StartPrimitive(segments*3,IUIRender::ptTriList,UI().m_currentPointType);
+        Fvector2 center; m_activeMap->WorkingArea().getcenter(center);
+        const float radius=m_activeMap->WorkingArea().width()*.5f,kx=UI().get_current_kx();
+        auto point=[&](float x,float y) {
+            Fvector2 pixel; UI().ClientToScreenScaled(pixel,x,y);
+            GEnv.UIRender->PushPoint(pixel.x,pixel.y,0,0xff000000,.5f,.5f);
+        };
+        for(int i=0;i<segments;++i) {
+            const float a=PI_MUL_2*i/segments,b=PI_MUL_2*(i+1)/segments;
+            point(center.x,center.y);
+            point(center.x+radius*kx*cosf(a),center.y+radius*sinf(a));
+            point(center.x+radius*kx*cosf(b),center.y+radius*sinf(b));
+        }
+        GEnv.UIRender->FlushPrimitive();
+        GEnv.UIRender->CacheSetCullMode(IUIRender::cmCCW);
+    }
+    CUIWindow::Draw();
+}
