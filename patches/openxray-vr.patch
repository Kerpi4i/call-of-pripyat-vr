+// Use the existing collision-resolving interpolation for growth. A temporary
+// target slot avoids the same-box early-out without changing native box layouts.
+bool CPHMovementControl::ResizeStandingBoxVR(const Fbox& target)
+{
+    if(BoxID()!=0||!CharacterExist()) return false;
+    if(_abs(target.vMax.y-aabb.vMax.y)<.005f) return true;
+    if(target.vMax.y<=aabb.vMax.y) {
+        boxes[0]=target; ActivateBox(0); return true;
+    }
+    const Fbox saved=boxes[1];
+    boxes[1]=target;
+    const bool success=ActivateBoxDynamic(1,5,3,.005f);
+    if(success) { boxes[0]=target; ActivateBox(0); }
+    boxes[1]=saved;
+    return success;
+}
