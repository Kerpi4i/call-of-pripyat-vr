+            Frect rect; child->GetAbsoluteRect(rect);
+            bounds.left=_min(bounds.left,rect.left); bounds.top=_min(bounds.top,rect.top);
+            bounds.right=_max(bounds.right,rect.right); bounds.bottom=_max(bounds.bottom,rect.bottom);
+        }
+        Fvector2 position; position.set(old.x+(256-bounds.width())*.5f-bounds.left,
+            old.y+(256-bounds.height())*.5f-bounds.top);
+        UIZoneMap->SetWndPos(position); UIZoneMap->Update(actor); UIZoneMap->Draw();
+        UIZoneMap->SetWndPos(old); UIZoneMap->Update(actor);
+    } else {
+        UpdateBoosterIndicators(actor->conditions().GetCurBoosterInfluences());
+        float statusTop=140.f;
+        if(m_ui_hud_states) {
+            // Move the native bottom-right HUD panel into the hand capture.
+            // Its original textures, health/stamina bars, ammo and logic remain native.
+            Frect bounds; bool found=false;
+            for(auto child:m_ui_hud_states->GetChildWndList()) {
+                const auto point=child->GetWndPos();
+                if(!child->IsShown()||point.x<UI_BASE_WIDTH*.5f||point.y<UI_BASE_HEIGHT*.5f) continue;
+                Frect rect; child->GetAbsoluteRect(rect);
+                if(!found) { bounds=rect; found=true; }
+                else {
+                    bounds.left=_min(bounds.left,rect.left); bounds.top=_min(bounds.top,rect.top);
+                    bounds.right=_max(bounds.right,rect.right); bounds.bottom=_max(bounds.bottom,rect.bottom);
+                }
+            }
+            if(found) {
+                const auto old=m_ui_hud_states->GetWndPos();
+                m_ui_hud_states->SetWndPos(Fvector2().set(old.x+128.f-(bounds.left+bounds.right)*.5f,old.y+8.f-bounds.top));
+                m_ui_hud_states->Draw(); m_ui_hud_states->SetWndPos(old);
+                statusTop=_min(144.f,16.f+bounds.height());
+            }
+        }
+        CUIStatic* icons[]={m_ind_bleeding,m_ind_radiation,m_ind_starvation,m_ind_overweight,m_ind_weapon_broken,m_ind_helmet_broken,m_ind_outfit_broken,
