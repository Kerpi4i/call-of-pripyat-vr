+        int index=0;
+        for(auto icon:icons) {
+            if(!icon||!icon->IsShown()) continue;
+            const auto position=icon->GetWndPos(),size=icon->GetWndSize();
+            icon->SetWndPos(Fvector2().set(36+(index%5)*38.f,statusTop+(index/5)*34.f)); icon->SetWndSize(Fvector2().set(32,32));
+            icon->Draw(); icon->SetWndPos(position); icon->SetWndSize(size); ++index;
+        }
+    }
+    UI().RenderFont();
+}
