+
+bool CGrenade::PrimeVR()
+{
+    if(!strstr(Core.Params,"-copvr")||!IsGameTypeSingle()||!Local()||!smart_cast<CActor*>(H_Parent())||
+        IsPending()||GetState()!=eIdle||m_thrown) return false;
+    if(!m_copvrPrimed) { Fvector center; Center(center); PlaySound("sndCheckout",center); m_copvrPrimed=true; }
+    if(!m_fake_missile&&Device.dwTimeGlobal>=m_copvrSpawnAfter) {
+        spawn_fake_missile(); m_copvrSpawnAfter=Device.dwTimeGlobal+500;
+    }
+    return true;
+}
+
+void CGrenade::CancelPrimeVR()
+{
+    if(!strstr(Core.Params,"-copvr")||!smart_cast<CActor*>(H_Parent())||m_thrown) return;
+    // The native fuse starts in Throw(), not PrimeVR(). Keep the attached fake
+    // missile for reuse; no live grenade is detached and inventory count stays.
+    m_copvrPrimed=false; m_copvrThrow=false;
+}
+
+bool CGrenade::ThrowVR(const Fmatrix& pose,const Fvector& linear,const Fvector& angular)
+{
+    if(!m_copvrPrimed||!PrimeVR()||!m_fake_missile) return false;
+    m_copvrThrow=true; m_copvrThrowPose=pose;
+    m_copvrThrowLinear=linear; m_copvrThrowAngular=angular;
+    Throw();
+    if(!m_thrown) return false;
+    m_copvrPrimed=false; FinishThrow(); return true;
+}
