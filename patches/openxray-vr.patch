+    auto target=holder?holder->TopInputReceiver():nullptr;
+    CopVrPointer pointer{}; pointer.abi=COPVR_POINTER_ABI;
+    auto module=GetModuleHandleA("copvr_bridge.dll");
+    auto sample=module?reinterpret_cast<CopVrGetPointer>(GetProcAddress(module,"copvr_get_pointer")):nullptr;
+    const bool valid=target && sample && sample(&pointer)>0;
+    copvr_ui::mouseHeld()=valid&&gate.pressed();
+    if(target!=previous || (valid && pointer.hand!=previousHand)) {
+        if(target!=previous) { gripGates[0].reset(); gripGates[1].reset(); }
+        if(gate.reset()<0 && target && target==previous) holder->IR_UIOnKeyboardRelease(MOUSE_1);
+    }
+    previous=target; previousHand=valid?pointer.hand:2;
+    if(valid) {
+        GetUICursor().SetUICursorPosition({pointer.x*UI_BASE_WIDTH,pointer.y*UI_BASE_HEIGHT});
+        target->OnMouseAction(pointer.x*UI_BASE_WIDTH,pointer.y*UI_BASE_HEIGHT,WINDOW_MOUSE_MOVE);
+        if(navValid&&std::isfinite(nav.scrollY)&&std::abs(nav.scrollY)>.3f)
+            holder->IR_UIOnMouseWheel(0,nav.scrollY*std::min(Device.fTimeDeltaReal,.05f)*8.f);
+    }
+    CopVrControls uiControls{}; uiControls.abi=COPVR_CONTROLS_ABI;
+    auto sampleUI=module?reinterpret_cast<CopVrGetControls>(GetProcAddress(module,"copvr_get_ui_controls")):nullptr;
+    const bool uiHands=target&&sampleUI&&sampleUI(&uiControls)>0;
+    int gripEdges[2]{};
+    for(int hand=0;hand<2;++hand) {
+        const bool tracked=uiHands&&uiControls.hands[hand].valid;
+        gripEdges[hand]=gripGates[hand].update(tracked,tracked?uiControls.hands[hand].squeeze:0.f);
+    }
+    const int gripEdge=valid&&pointer.hand<2?gripEdges[pointer.hand]:0;
+    if(valid&&smart_cast<CUIPdaWnd*>(target)&&gripEdge) {
+        if(gripEdge>0) holder->IR_UIOnKeyboardPress(MOUSE_2);
+        else holder->IR_UIOnKeyboardRelease(MOUSE_2);
+    }
+    if(gripEdge>0&&gate.pressed()) {
+        auto inventory=smart_cast<CUIActorMenu*>(target);
+        if(inventory&&inventory->VrUnloadDragged(static_cast<int>(pointer.hand))) return;
+    }
+    if(gripEdge>0&&!gate.pressed()&&pointer.trigger<.25f) {
+        auto inventory=smart_cast<CUIActorMenu*>(target);
+        if(inventory&&inventory->VrExtractHovered(static_cast<int>(pointer.hand))) {
+            gate.reset(); gripGates[0].reset(); gripGates[1].reset(); target->HideDialog(); return;
+        }
+    }
+    const int edge=gate.update(valid,pointer.trigger);
+    copvr_ui::mouseHeld()=valid&&gate.pressed();
+    if(!holder) return;
+    if(edge>0) { holder->IR_UIOnKeyboardPress(MOUSE_1); Msg("* CoPVR: UI Touch press hand=%u",pointer.hand); }
+    else if(edge<0) holder->IR_UIOnKeyboardRelease(MOUSE_1);
+    else if(valid && gate.pressed()) holder->IR_UIOnKeyboardHold(MOUSE_1);
+}
