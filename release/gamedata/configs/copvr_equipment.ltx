; Units: metres. Rotations: heading, pitch, bank in degrees.
; Restart the game after editing. Defaults are provisional, headset validation pending.
[body]
standing_mode = true
debug_zones = false
debug_other_zones = true
grenade = -0.34, -0.63, 0.00
frame_position = 0, 0, 0
frame_rotation = 0, 0, 0
left_hip = -0.39, -0.88, -0.12
right_hip = 0.39, -0.88, -0.12
left_shoulder = -0.27, -0.16, -0.25
right_shoulder = 0.27, -0.16, -0.25
; Equipment follows a shallow waist arc rather than a floating front shelf.
belt_0 = -0.27, -0.61, 0.13
belt_1 = -0.09, -0.61, 0.20
belt_2 = 0.09, -0.61, 0.20
belt_3 = 0.27, -0.61, 0.13
; Quick slots remain individually adjustable for reach and separation.
belt_5 = -0.30, -0.83, 0.05
belt_6 = -0.10, -0.83, 0.14
belt_7 = 0.10, -0.83, 0.14
belt_8 = 0.30, -0.83, 0.05

; Per-item corrections to the authored HUD wrist attachments.
; Zero means the skeleton's authored right grip and its calibrated left counterpart.
[hands]
; Weak adaptive pose filtering in tracking space; raw velocities retained for throws/melee.
smoothing_enabled = true
position_min_cutoff = 12
rotation_min_cutoff = 10
position_smoothing_beta = 20
rotation_smoothing_beta = 8
; Bullet/pellet cone while an actual tracked support grip is held.
supported_dispersion_scale = 0.55
; Additional multiplier only while an eye sees the aligned scope pupil.
scoped_dispersion_scale = 0.40
; Controller grip origin is the palm interaction point, not the wrist bone.
left_palm = 0, 0, 0
right_palm = 0, 0, 0

