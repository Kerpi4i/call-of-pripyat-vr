Texture2D s_base; Texture2D s_reticle; SamplerState smp_rtlinear;
uniform float4 screen_res;
float4 main(float4 P:SV_Position,float2 uv:TEXCOORD0,float2 tube:TEXCOORD1):SV_Target {
    float radius=length(tube);
    // Opaque wall of a black tube; the ray must also pass its farther circular opening.
    float opening=1-smoothstep(.98,1.02,radius);
    float2 sampleUV=float2(.5+(uv.x-.5)*screen_res.y*screen_res.z,uv.y);
    float valid=all(uv>=0)&&all(uv<=1)?1:0;
    float3 scene=s_base.Sample(smp_rtlinear,saturate(sampleUV)).rgb;
    // Fit the entire native scale at the far opening, rather than cropping it
    // to the much larger apparent field used for collimated scene sampling.
    float2 reticleUV=.5+float2(tube.x*.36,-tube.y*.46);
    float4 reticle=s_reticle.Sample(smp_rtlinear,saturate(reticleUV));
    float coverage=smoothstep(.70,.94,reticle.a);
    float3 colour=lerp(scene,reticle.rgb,coverage);
    return float4(colour*opening*valid,1);
}
